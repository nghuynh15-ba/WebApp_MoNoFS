@{
    ViewBag.Title = "ABOUT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="about-page">
    <section class="about-hero-section">
        <div class="container">
            <h1 class="about-title">About Us</h1>
            <p class="about-subtitle">
                Founded on the belief that true style is built on quality, not trends. We craft essentials for the
                sophisticated wardrobe.
            </p>
        </div>
    </section>


    <div class="about-content-wrapper">

        <section class="py-5 brand-story-section brand-story-v2">
            <div class="container">
                <div class="row align-items-center">

                    <div class="col-lg-6 mb-4 mb-lg-0 brand-story-image-column">
                    </div>

                    <div class="col-lg-6 brand-story-content-column">
                        <div class="story-text-box">
                            <span class="section-kicker">Discover</span>
                            <h2 class="section-title-v2">OUR STORY</h2>
                            <p class="brand-story-text">
                                MONO Fashion was founded in 2015 by a team passionate about reclaiming the simplicity of
                                fashion. We believe in investing in fewer, better items. Our journey has been about
                                stripping away the essence of elegance. From the initial sketch to the final shipment,
                                the MONO Promise is a commitment to you—and to the planet. We invite you to explore the
                                pieces that are designed to evolve with you, becoming true classics in your life.
                            </p>
                            <p class="brand-story-text">
                                We focus on curated, high-quality essentials designed to be the foundation of a
                                sophisticated wardrobe. Every piece is crafted with meticulous attention to detail,
                                ensuring elegance and longevity.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 core-values-section">
            <div class="container">
                <div class="row text-center mb-5">
                    <div class="col-12">
                        <span class="section-kicker">Our Core</span>
                        <h2 class="section-title">VALUES WE STAND FOR</h2>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="value-card">
                            <i class="fas fa-gem"></i>
                            <h4>Timeless Quality</h4>
                            <p>
                                We source only the finest materials, focusing on meticulous craftsmanship that ensures
                                every
                                piece lasts beyond the season.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="value-card">
                            <i class="fas fa-heart"></i>
                            <h4>Ethical Production</h4>
                            <p>
                                MONO is committed to transparent and ethical production, ensuring fair wages and
                                responsible
                                practices across our entire supply chain.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="value-card">
                            <i class="fas fa-pencil-ruler"></i>
                            <h4>Minimalist Design</h4>
                            <p>
                                Our designs embrace simplicity and sophistication, creating versatile, essential items
                                that
                                define the modern aesthetic.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="py-5 testimonial-section">
            <div class="container">
                <div class="row text-center mb-5">
                    <div class="col-12">
                        <span class="section-kicker">Testimony</span>
                        <h2 class="section-title">CUSTOMERS SAYS</h2>
                        <p class="section-subtitle-dark">
                            See what people are saying about MONO Fashion's timeless
                            quality.
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="testimonial-card">
                            <p class="quote-text">
                                "The quality is simply unmatched. My new cardigan is the perfect blend of modern style
                                and comfortable wear. A truly essential piece in my minimalist wardrobe."
                            </p>
                            <div class="customer-info">
                                <img src="https://plus.unsplash.com/premium_photo-1679440415182-c362deb2fd40?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8d29tZW58ZW58MHx8MHx8fDA%3D&auto=format&fit=crop&q=60&w=1000"
                                     alt="Customer Avatar" class="customer-avatar me-3">
                                <div class="text-start">
                                    <h5 class="customer-name">Louise Kelly</h5>
                                    <p class="customer-title">Illustrator Designer</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="testimonial-card">
                            <p class="quote-text">
                                "MONO's commitment to ethical production convinced me to make the switch. The classic
                                black dress is flawless, and I feel good knowing my purchase supports fair labor."
                            </p>
                            <div class="customer-info">
                                <img src="https://plus.unsplash.com/premium_photo-1672239496290-5061cfee7ebb?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8bWVufGVufDB8fDB8fHww&auto=format&fit=crop&q=60&w=1000"
                                     alt="Customer Avatar" class="customer-avatar me-3">
                                <div class="text-start">
                                    <h5 class="customer-name">J. Alexander</h5>
                                    <p class="customer-title">Fashion Blogger</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12 mb-4">
                        <div class="testimonial-card">
                            <p class="quote-text">
                                "The timeless design means I can wear this piece for years without worrying about
                                trends. Worth every penny for the lasting quality and sophisticated aesthetic."
                            </p>
                            <div class="customer-info">
                                <img src="https://images.unsplash.com/photo-1560087637-bf797bc7796a?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NHx8d29tZW58ZW58MHx8MHx8fDA%3D&auto=format&fit=crop&q=60&w=1000"
                                     alt="Customer Avatar" class="customer-avatar me-3">
                                <div class="text-start">
                                    <h5 class="customer-name">Mark S.</h5>
                                    <p class="customer-title">Creative Director</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="py-5 counters-section">
            <div class="container">
                <div class="row text-center">

                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-box">
                            <div class="counter-content">
                                <i class="fas fa-tshirt"></i>
                                <span class="counter-number">120,000+</span>
                                <p class="counter-label">Pieces Crafted</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-box">
                            <div class="counter-content">
                                <i class="fas fa-heart"></i>
                                <span class="counter-number">9,500+</span>
                                <p class="counter-label">Happy Customers</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-box">
                            <div class="counter-content">
                                <i class="fas fa-store-alt"></i>
                                <span class="counter-number">45</span>
                                <p class="counter-label">Stores Worldwide</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-box">
                            <div class="counter-content">
                                <i class="fas fa-seedling"></i>
                                <span class="counter-number">100+</span>
                                <p class="counter-label">Ethical Partners</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </div>
</section>


