@model List<WebApp_MoNoFS.Models.Order>

@{
    ViewBag.Title = "My Orders";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";

    //  GỘP NHÓM TRẠNG THÁI 

    // Nhóm "Đang thực hiện": Gồm Chờ xử lý, Đã duyệt, Đang giao
    var activeOrders = Model.Where(o => o.Status == "Pending" || o.Status == "Confirmed" || o.Status == "Shipping")
                            .OrderByDescending(o => o.OrderDate).ToList();

    // Nhóm "Hoàn thành"
    var completedOrders = Model.Where(o => o.Status == "Completed" || o.Status == "Delivered")
                               .OrderByDescending(o => o.OrderDate).ToList();

    // Nhóm "Hủy": Gồm Đã hủy và Đang yêu cầu hủy
    var cancelledOrders = Model.Where(o => o.Status == "Cancelled" || o.Status == "RequestCancel")
                               .OrderByDescending(o => o.OrderDate).ToList();
}

<style>
    
    .nav-tabs .nav-link {
        border: none;
        color: #999;
        font-weight: 600;
        padding: 15px 0;
        background: transparent;
    }

    .nav-tabs .nav-link.active {
            color: #000;
            border-bottom: 3px solid #000;
        }

     .nav-tabs .nav-link:hover {
            color: #333;
        }

    .nav-tabs .nav-item {
        flex: 1;
        text-align: center;
        cursor: pointer;
    }
</style>

<section class="py-5" style="background-color: #f5f5f5; min-height: 85vh;">
    <div class="container">
        <h3 class="mb-4 fw-bold text-uppercase">My Orders</h3>

        <div class="bg-white shadow-sm rounded mb-4 sticky-top" style="top: 70px; z-index: 99;">
            <ul class="nav nav-tabs" id="orderTabs" role="tablist">

                <li class="nav-item">
                    <button class="nav-link active w-100" data-bs-toggle="tab" data-bs-target="#all">ALL</button>
                </li>

                <li class="nav-item">
                    <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#active">
                        IN PROGRESS
                        @if (activeOrders.Any())
                        {<span class="badge bg-primary rounded-pill ms-1" style="font-size: 10px;">@activeOrders.Count</span>}
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#completed">COMPLETED</button>
                </li>

                <li class="nav-item">
                    <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#cancelled">
                        CANCELLED
                        @if (cancelledOrders.Any(o => o.Status == "RequestCancel"))
                        {<span class="badge bg-warning rounded-circle ms-1" style="width: 8px; height: 8px; padding: 0;"> </span>}
                    </button>
                </li>

            </ul>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="all">
                @RenderOrderList(Model)
            </div>

            <div class="tab-pane fade" id="active">
                @RenderOrderList(activeOrders)
            </div>

            <div class="tab-pane fade" id="completed">
                @RenderOrderList(completedOrders)
            </div>

            <div class="tab-pane fade" id="cancelled">
                @RenderOrderList(cancelledOrders)
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="cancelConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Confirm Cancellation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <p class="fs-5">Request cancel for Order <strong id="modalOrderIdText">#...</strong>?</p>
                <small class="text-muted">Admin will review your request shortly.</small>
            </div>
            <div class="modal-footer justify-content-center border-0 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep Order</button>
                <button type="button" class="btn btn-danger fw-bold" id="btnConfirmCancel">Yes, Send Request</button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hiddenOrderId" />


@helper RenderOrderList(List<WebApp_MoNoFS.Models.Order> orders)
{
    if (orders == null || orders.Count == 0)
    {
        <div class="text-center py-5">
            <div class="text-muted opacity-50 mb-3"><i class="fas fa-clipboard-list fa-3x"></i></div>
            <p class="text-muted">No orders in this tab.</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-dark rounded-pill px-4">Go Shopping</a>
        </div>
    }
    else
    {
        foreach (var item in orders)
        {
            // LOGIC MÀU SẮC & TIẾN TRÌNH
            int progress = 0;
            string statusColor = "bg-secondary"; 
            string progressBarColor = "bg-success";

            // Set % tiến trình
            if (item.Status == "Pending") { progress = 25; statusColor = "bg-primary"; }
            else if (item.Status == "Confirmed") { progress = 50; statusColor = "bg-info text-dark"; }
            else if (item.Status == "Shipping") { progress = 75; statusColor = "bg-warning text-dark"; }
            else if (item.Status == "Completed" || item.Status == "Delivered") { progress = 100; statusColor = "bg-success"; }

            // Logic đặc biệt cho nhóm Hủy
            else if (item.Status == "Cancelled")
            {
                progress = 0;
                statusColor = "bg-secondary"; 
                progressBarColor = "bg-secondary";
            }
            else if (item.Status == "RequestCancel")
            {
                progress = 50; 
                statusColor = "bg-warning text-dark";
                progressBarColor = "bg-warning"; 
            }

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <div>
                        <span class="fw-bold">Order #@item.OrderId</span>
                        <span class="text-muted small ms-2">| @(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
                    </div>

                    @if (item.Status == "RequestCancel")
                    {
                        <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i> Waiting Approval</span>
                    }
                    else if (item.Status == "Cancelled")
                    {
                        <span class="badge bg-secondary">CANCELLED</span>
                    }
                    else
                    {
                        <span class="badge @statusColor">@item.Status</span>
                    }
                </div>

                <div class="card-body p-4">

                    @if (item.Status != "Cancelled")
                    {
                        <div class="position-relative mb-4 mt-2 px-3">
                            <div class="progress" style="height: 3px;">
                                <div class="progress-bar @progressBarColor" role="progressbar" style="width: 100%;"></div>
                            </div>
                            <div class="d-flex justify-content-between position-absolute top-0 w-100" style="margin-top: -14px; left: 0;">
                                <div class="text-center" style="width: 25%;">
                                    <div class="rounded-circle bg-@(progress >= 25 ? "success" : "secondary") text-white d-flex align-items-center justify-content-center mx-auto" style="width: 30px; height: 30px;"><i class="fas fa-file-alt"></i></div>
                                    <small class="d-block mt-1" style="font-size: 11px;">Ordered</small>
                                </div>
                                <div class="text-center" style="width: 25%;">
                                    @if (item.Status == "RequestCancel")
                                    {
                                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center mx-auto" style="width: 30px; height: 30px;"><i class="fas fa-hourglass-half"></i></div>
                                        <small class="d-block mt-1 fw-bold text-warning" style="font-size: 11px;">Cancelling...</small>
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-@(progress >= 50 ? "success" : "secondary") text-white d-flex align-items-center justify-content-center mx-auto" style="width: 30px; height: 30px;"><i class="fas fa-wallet"></i></div>
                                        <small class="d-block mt-1" style="font-size: 11px;">Confirmed</small>
                                    }
                                </div>
                                <div class="text-center" style="width: 25%;">
                                    <div class="rounded-circle bg-@(progress >= 75 ? "success" : "secondary") text-white d-flex align-items-center justify-content-center mx-auto" style="width: 30px; height: 30px;"><i class="fas fa-truck"></i></div>
                                    <small class="d-block mt-1" style="font-size: 11px;">Shipping</small>
                                </div>
                                <div class="text-center" style="width: 25%;">
                                    <div class="rounded-circle bg-@(progress >= 100 ? "success" : "secondary") text-white d-flex align-items-center justify-content-center mx-auto" style="width: 30px; height: 30px;"><i class="fas fa-box"></i></div>
                                    <small class="d-block mt-1" style="font-size: 11px;">Delivered</small>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light text-center mb-4 border-0 text-muted">
                            <i class="fas fa-ban me-1"></i> Order has been cancelled.
                        </div>
                    }

                    <div class="bg-light rounded p-3 mb-3">
                        @foreach (var detail in item.OrderDetails)
                        {
                            <div class="d-flex align-items-center border-bottom pb-2 mb-2 last-border-0">
                                <div class="me-3">
                                    @if (detail.Product != null)
                                    {
                                        <img src="~/Images/@detail.Product.ProImage" class="rounded border bg-white" style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    @if (detail.Product != null)
                                    {
                                        <h6 class="mb-0 text-truncate" style="font-size: 14px; max-width: 250px;">@detail.Product.ProName</h6>
                                        <div class="d-flex align-items-center small text-muted">
                                            <span>Size: <strong>@detail.Size</strong></span>
                                            <span class="mx-2">|</span>
                                            <span>x @detail.Quantity</span>
                                        </div>
                                        <small class="text-muted">x @detail.Quantity</small>
                                    }
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-dark" style="font-size: 14px;">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", detail.Price * detail.Quantity)</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total:</small>
                            <span class="fw-bold text-danger fs-5">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", item.OrderDetails.Sum(d => d.Price * d.Quantity))</span>
                        </div>
                        <div>
                            @if (item.Status == "Pending" || item.Status == "Confirmed")
                            {
                                using (Html.BeginForm("CancelOrder", "Order", new { id = item.OrderId }, FormMethod.Post, new { id = "cancelForm-" + item.OrderId }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-danger btn-sm" onclick="showCancelModal(@item.OrderId)">
                                        Request Cancellation
                                    </button>
                                }
                            }
                            else if (item.Status == "RequestCancel")
                            {
                                <button type="button" class="btn btn-warning btn-sm text-dark" disabled style="cursor: not-allowed;">
                                    <i class="fas fa-spinner fa-spin me-1"></i> Waiting Approval...
                                </button>
                            }
                            else if (item.Status == "Cancelled")
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Cancelled</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-dark btn-sm">Track Order</button>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    }
}

<script>
    function showCancelModal(id) {
        document.getElementById('hiddenOrderId').value = id;
        document.getElementById('modalOrderIdText').innerText = '#' + id;
        new bootstrap.Modal(document.getElementById('cancelConfirmModal')).show();
    }
    document.getElementById('btnConfirmCancel').addEventListener('click', function () {
        var id = document.getElementById('hiddenOrderId').value;
        var form = document.getElementById('cancelForm-' + id);
        if (form) form.submit();
    });
</script>