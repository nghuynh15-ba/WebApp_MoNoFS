@model WebApp_MoNoFS.Models.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Invoice #@Model.OrderId - MONO FASHION</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Montserrat', sans-serif;
            padding: 40px 0;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            background: #fff;
            padding: 40px;
            border: 1px solid #eee;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
        }
        .brand-color { color: #c8a165; }
        .invoice-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: bold; }
        .table-invoice thead th {
            background-color: #000;
            color: #fff;
            border: none;
            padding: 12px;
        }
        .table-invoice tbody td { padding: 12px; vertical-align: middle; }
        .total-section { border-top: 2px dashed #c8a165; padding-top: 15px; }

        
    </style>
</head>
<body>

    <div class="invoice-box">
        <div class="d-flex justify-content-between align-items-start mb-5">
            <div>
                <h1 class="invoice-title">INVOICE</h1>
                <p class="text-muted mb-0">Order ID: <strong>#@Model.OrderId</strong></p>
                <p class="text-muted">Date: @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
            </div>
            <div class="text-end">
                <h4 class="fw-bold m-0">MONO FASHION</h4>
                <p class="small text-muted mb-0">123 Fashion Street, HCM City</p>
                <p class="small text-muted mb-0">Hotline: 1900 123 456</p>
                <p class="small text-muted">Website: monofashion.com</p>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <h6 class="fw-bold text-uppercase brand-color border-bottom pb-2 mb-3" style="width: 80%;">Bill To</h6>
                <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>
                <p class="mb-1"><strong>Email:</strong> @(string.IsNullOrEmpty(Model.CustomerEmail) ? "N/A" : Model.CustomerEmail)</p>
                <p class="mb-0"><strong>Address:</strong> @Model.CustomerAddress</p>
            </div>
            <div class="col-6">
                <h6 class="fw-bold text-uppercase brand-color border-bottom pb-2 mb-3" style="width: 80%;">Payment Info</h6>
                <p class="mb-1"><strong>Method:</strong> @Model.PaymentType</p>
                <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
            </div>
        </div>

        <table class="table table-invoice mb-4">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col" class="text-center">Code</th>
                    <th scope="col" class="text-center">Qty</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col" class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <span class="fw-bold">@(item.Product != null ? item.Product.ProName : "Product #" + item.ProductId)</span>
                        </td>
                        <td class="text-center text-muted small">#@item.ProductId</td>
                        <td class="text-center">
                            <span class="fw-bold text-dark border px-2 py-1 rounded small">@item.Size</span>
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", item.Price)</td>
                        <td class="text-end fw-bold">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", item.Price * item.Quantity)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row total-section">
            <div class="col-6">
                <p class="text-muted small fst-italic">
                    * Please check your invoice carefully.<br>
                    * Returns are accepted within 7 days with this invoice.
                </p>
            </div>
            <div class="col-6 text-end">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span class="fw-bold">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", Model.OrderDetails.Sum(x => x.Price * x.Quantity))</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Shipping Fee:</span>
                    <span class="text-muted">Free</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h5 class="fw-bold mb-0">TOTAL DUE:</h5>
                    <h3 class="fw-bold brand-color mb-0">
                        @string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", Model.OrderDetails.Sum(x => x.Price * x.Quantity))
                    </h3>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 mb-3">
            <p class="fw-bold" style="font-family: 'Playfair Display', serif; font-size: 1.2rem;">Thank you for choosing Mono Fashion!</p>
        </div>

        <div class="text-center btn-print-group mt-4 mb-5">
            <button onclick="window.print()" class="btn btn-dark btn-lg me-2 shadow">
                <i class="fas fa-print me-2"></i> Print Invoice
            </button>

            <button onclick="window.close()" class="btn btn-outline-secondary btn-lg shadow-sm">
                Close Window
            </button>
        </div>
    </div>

</body>
</html>