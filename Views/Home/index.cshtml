@using WebApp_MoNoFS.Models
@model IEnumerable<WebApp_MoNoFS.Models.Product>

@{
    ViewBag.Title = "HOME";
    Layout = "~/Views/Shared/_Layout.cshtml";



    var womenList = ViewBag.womenList as List<WebApp_MoNoFS.Models.Product>;
    var menList = ViewBag.menList as List<WebApp_MoNoFS.Models.Product>;
    var accesoriesList = ViewBag.accesoriesList as List<WebApp_MoNoFS.Models.Product>;

}



@* === PHẦN 1: HERO CAROUSEL=== *@
<div class="hero-wrapper">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">

        <div class="carousel-inner">
            <div class="carousel-item active" id="slide1">
                <div class="container hero-content">
                    <div class="row">
                        <div class="col-lg-8 col-md-10 mx-auto text-center">
                            <h1 class="display-4 fw-bold">MONO FASHION WELCOME</h1>
                            <p class="lead">Discover your style with our latest collection.</p>
                            <a href="@Url.Action("Index", "Product")" class="btn btn-warning btn-lg me-2">Shop Now</a>
                            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-light btn-lg">View Products</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item" id="slide2">
                <div class="container hero-content">
                    <div class="row">
                        <div class="col-lg-8 col-md-10 mx-auto text-center">
                            <h1 class="display-4 fw-bold">WINTER SALE UP TO 50%</h1>
                            <p class="lead">Don't miss the biggest sale of this winter.</p>
                            <a href="@Url.Action("Index", "Product", new { q = "sale" })" class="btn btn-warning btn-lg me-2">Shop Sale</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item" id="slide3">
                <div class="container hero-content">
                    <div class="row">
                        <div class="col-lg-8 col-md-10 mx-auto text-center">
                            <h1 class="display-4 fw-bold">NEW ARRIVALS</h1>
                            <p class="lead">Just landed products are waiting for you.</p>
                            <a href="@Url.Action("Index", "Product", new { sort = "newest" })" class="btn btn-outline-light btn-lg">View Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* === PHẦN 2: FEATURED PRODUCTS  === *@

<section class="featured-products">
    <div class="container">

        <div class="row">
            <div class="col-12 text-center mb-4">
                <span class="section-kicker">Discover</span>
                <h2 class="section-title">FEATURED PRODUCTS</h2>
                <p class="section-subtitle">Discover the curated collection for this season.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-12 d-flex justify-content-center">
                <ul class="nav nav-tabs product-nav-tabs mb-4" id="productTab" role="tablist">

                    <li class="nav-item" role="presentation">

                        <button class="nav-link active" id="women-tab" data-bs-toggle="tab"
                                data-bs-target="#women-panel" type="button" role="tab">

                            Women

                        </button>

                    </li>

                    <li class="nav-item" role="presentation">

                        <button class="nav-link" id="men-tab" data-bs-toggle="tab" data-bs-target="#men-panel"
                                type="button" role="tab">

                            Men

                        </button>

                    </li>
                    <li class="nav-item" role="presentation">

                        <button class="nav-link" id="accessories-tab" data-bs-toggle="tab"
                                data-bs-target="#accessories-panel" type="button" role="tab">

                            Accessories

                        </button>

                    </li>

                </ul>

            </div>

        </div>
    </div>



    <div class="tab-content" id="productTabContent">
        <div class="tab-pane fade show active" id="women-panel" role="tabpanel">
            <div class="row">
                @if (womenList != null && womenList.Any())
                {
                    foreach (var product in womenList)
                    {
                        @Html.Partial("_ProductCard", product)
                    }
                }
            </div>
            <div class="row mt-4 pt-3">
                <div class="col-12 text-center">
                    <a href="@Url.Action("Index", "Product", new { categoryId = 1 })" class="btn-mono-outline">View All Women's</a>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="men-panel" role="tabpanel">
            <div class="row">
                @if (menList != null && menList.Any())
                {
                    foreach (var product in menList)
                    {
                        @Html.Partial("_ProductCard", product)
                    }
                }
            </div>
            <div class="row mt-4 pt-3">
                <div class="col-12 text-center">
                    <a href="@Url.Action("Index", "Product", new { categoryId = 2 })" class="btn-mono-outline">View All Men's</a>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="accessories-panel" role="tabpanel">
            <div class="row">
                @if (accesoriesList != null && accesoriesList.Any())
                {
                    foreach (var product in accesoriesList)
                    {
                        @Html.Partial("_ProductCard", product)
                    }
                }
            </div>
            <div class="row mt-4 pt-3">
                <div class="col-12 text-center">
                    <a href="@Url.Action("Index", "Product", new { categoryId = 3 })" class="btn-mono-outline">View All Accessories</a>
                </div>
            </div>
        </div>
    </div>


</section>


@* === PHẦN 3: VIDEO === *@
<section class="featured-video-section" style="padding: 0; margin: 0; line-height: 0;">
    <video style="width: 100%; height: 100%; object-fit:cover; display: block;"  
           autoplay
           muted
           loop
           playsinline
           preload="auto">
        <source src="@Url.Content("~/Images/1114.mp4")" type="video/mp4">

    </video>
</section>


@* === PHẦN 4: COLLECTION === *@
<section class="collections-section">
