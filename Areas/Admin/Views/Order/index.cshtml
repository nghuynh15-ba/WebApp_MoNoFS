@model IEnumerable<WebApp_MoNoFS.Models.Order>

@{
    ViewBag.Title = "Order Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // SPLIT LIST INTO 2 PARTS
    var cancelRequests = Model.Where(o => o.Status == "RequestCancel").ToList();
    var normalOrders = Model.Where(o => o.Status != "RequestCancel").ToList();
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title" style="font-family: 'Playfair Display', serif; font-weight: 700;">Orders List</h2>
</div>

@if (cancelRequests.Any())
{
    <div class="card border-danger shadow-sm mb-5">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-exclamation-circle me-2"></i> CANCELLATION REQUESTS (@cancelRequests.Count)</h5>
            <small>Action Required</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-danger">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Reason</th>
                            <th class="text-end pe-4">Quick Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in cancelRequests)
                        {
                            <tr style="background-color: #fff5f5;">
                                <td class="ps-4 fw-bold text-danger">#@item.OrderId</td>
                                <td>@(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM HH:mm") : "-")</td>
                                <td>
                                    <span class="fw-bold">@item.CustomerName</span><br />
                                    <small class="text-muted">@item.CustomerPhone</small>
                                </td>
                                <td class="text-end fw-bold">
                                    @String.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", item.OrderDetails.Sum(d => d.Price * d.Quantity))
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger">Customer Requested</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        @using (Html.BeginForm("ApproveCancel", "Order", new { id = item.OrderId }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm fw-bold"
                                                    onclick="return confirmAction(event, this, 'Approve Cancellation?', 'Are you sure you want to APPROVE this request?', '#dc3545');">
                                                <i class="fas fa-check me-1"></i> Approve
                                            </button>
                                        }

                                        @using (Html.BeginForm("RejectCancel", "Order", new { id = item.OrderId }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                    onclick="return confirmAction(event, this, 'Reject Cancellation?', 'Do you want to REJECT this request and continue shipping?', '#3085d6');">
                                                <i class="fas fa-times me-1"></i> Reject
                                            </button>
                                        }

                                        <a href="@Url.Action("Details", new { id = item.OrderId })" class="btn btn-light btn-sm border" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light">
        @using (Html.BeginForm("Index", "Order", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-auto">
                <label class="fw-bold me-2">Search Order:</label>
            </div>
            <div class="col-auto">
                <div class="input-group">
                    <span class="input-group-text bg-white rounded-0 border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>

                    <input type="text"
                           name="searchKeyword"
                           value="@ViewBag.CurrentKeyword"
                           class="form-control rounded-0 border-start-0"
                           placeholder="Enter ID, Name or Phone..."
                           style="width: 300px;">

                    <button type="submit" class="btn btn-dark rounded-0">
                        Filter
                    </button>

                    @if (!string.IsNullOrEmpty(ViewBag.CurrentKeyword))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-0" title="Clear Filter">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 text-muted">All Orders History</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!normalOrders.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No orders found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in normalOrders)
                        {
                            decimal total = 0;
                            if (item.OrderDetails != null && item.OrderDetails.Any())
                            {
                                total = (decimal)item.OrderDetails.Sum(d => d.Price * d.Quantity);
                            }

                            <tr>
                                <td class="ps-4 fw-bold">#@item.OrderId</td>
                                <td>
                                    @if (item.OrderDate.HasValue)
                                    {
                                        @item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold">@item.CustomerName</span><br />
                                    <small class="text-muted">@item.CustomerPhone</small>
                                </td>
                                <td class="text-end font-monospace fw-bold">
                                    @String.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", total)
                                </td>
                                <td class="text-center">
                                    @{
                                        string statusClass = "bg-secondary";
                                        if (item.Status == "Pending") { statusClass = "bg-primary"; }
                                        else if (item.Status == "Confirmed") { statusClass = "bg-info text-dark"; }
                                        else if (item.Status == "Shipping") { statusClass = "bg-warning text-dark"; }
                                        else if (item.Status == "Completed") { statusClass = "bg-success"; }
                                        else if (item.Status == "Cancelled") { statusClass = "bg-secondary"; }
                                    }
                                    <span class="badge @statusClass rounded-0">@item.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Edit", new { id = item.OrderId })" class="btn btn-sm btn-outline-dark rounded-0 me-1" title="Update Status">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.OrderId })" class="btn btn-sm btn-dark rounded-0" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmAction(event, element, title, message, btnColor) {
            event.preventDefault(); // Prevent default form submission

            var form = element.closest('form');

            Swal.fire({
                title: title,
                text: message,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: btnColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, confirm',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // If user confirms, submit the form manually
                    form.submit();
                }
            });
            return false;
        }
    </script>
}