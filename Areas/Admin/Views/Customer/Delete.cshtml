@model WebApp_MoNoFS.Models.Customer

@{
    ViewBag.Title = "Delete Customer";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid" style="max-width: 600px;">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger rounded-0">
            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
        </div>
    }

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="fas fa-user-times fa-4x text-danger opacity-25"></i>
            </div>

            <h3 class="fw-bold mb-2">Delete Account?</h3>
            <p class="text-muted mb-4">Are you sure you want to delete customer <strong>@Model.Fullname</strong> (@Model.Username)?</p>

            <div class="alert alert-light border text-start mb-4">
                <small class="d-block text-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> Warning:</small>
                <small>This action will permanently remove the user from the database. If this user has Order History, consider <strong>Deactivating</strong> (Locking) the account instead of deleting.</small>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-dark rounded-0 px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-0 px-4">Confirm Delete</button>
                </div>
            }
        </div>
    </div>
</div>