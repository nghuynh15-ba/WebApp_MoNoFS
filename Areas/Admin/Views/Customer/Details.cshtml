@model WebApp_MoNoFS.Models.Customer

@{
    ViewBag.Title = "Customer Profile";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title" style="font-family: 'Playfair Display', serif; font-weight: 700;">Customer Profile</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-dark rounded-0">Back to List</a>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body p-4">
                    <img src="~/Content/images/customers/@(string.IsNullOrEmpty(Model.Photo) ? "default-user.png" : Model.Photo)"
                         class="rounded-circle mb-3 border"
                         style="width: 120px; height: 120px; object-fit: cover;"
                         onerror="this.src='https://placehold.co/120x120?text=User'" />

                    <h4 class="fw-bold">@Model.Fullname</h4>
                    <p class="text-muted">@Model.Username</p>

                    <hr />

                    <div class="text-start">
                        <p><strong><i class="fas fa-envelope me-2"></i> Email:</strong> @Model.Email</p>
                        <p><strong><i class="fas fa-phone me-2"></i> Phone:</strong> @Model.Phone</p>
                        <p><strong><i class="fas fa-map-marker-alt me-2"></i> Address:</strong> <br /> @Model.Address</p>
                        <p>
                            <strong><i class="fas fa-toggle-on me-2"></i> Status:</strong>
                            @(Model.Activated == true ? "Active" : "Locked")
                        </p>
                    </div>

                    <div class="mt-4">
                        <a href="@Url.Action("Edit", new { id = Model.UserId })" class="btn btn-dark rounded-0 w-100">Edit Profile</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white rounded-0">
                    <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i> Order History</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Order ID</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">#@order.OrderId</td>
                                            <td>@(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("dd/MM/yyyy") : "")</td>
                                            <td><span class="badge bg-light text-dark border">@order.Status</span></td>
                                            <td class="text-end pe-4">
                                                <a href="@Url.Action("Details", "Order", new { id = order.OrderId })" class="btn btn-sm btn-outline-dark rounded-0">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-box-open fa-2x mb-2"></i>
                            <p>No orders placed yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>