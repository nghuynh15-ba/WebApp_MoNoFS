@model WebApp_MoNoFS.Models.Product

@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title" style="font-family: 'Playfair Display', serif; font-weight: 700;">Edit Product: @Model.ProName</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-dark rounded-0">
            <i class="fas fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ProId) @Html.HiddenFor(model => model.ProImage) <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Product Name</label>
                            @Html.EditorFor(model => model.ProName, new { htmlAttributes = new { @class = "form-control rounded-0" } })
                            @Html.ValidationMessageFor(model => model.ProName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Category</label>
                                @Html.DropDownList("CatId", null, new { @class = "form-select rounded-0" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Price ($)</label>
                                @Html.EditorFor(model => model.ProPrice, new { htmlAttributes = new { @class = "form-control rounded-0" } })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control rounded-0", rows = "3" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Details</label>
                            @Html.TextAreaFor(model => model.Details, new { @class = "form-control rounded-0", rows = "3" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Fit & Care</label>
                            @Html.TextAreaFor(model => model.FitAndCare, new { @class = "form-control rounded-0", rows = "2" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-light border-0 rounded-0">
                            <div class="card-body text-center">
                                <label class="form-label fw-bold mb-3">Current Image</label>
                                <div class="mb-3 border bg-white d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <img id="previewImg" src="~/Images/@Model.ProImage" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                </div>
                                <label class="form-label small text-muted">Change Image (Optional)</label>
                                <input type="file" name="UploadImage" class="form-control rounded-0" onchange="document.getElementById('previewImg').src = window.URL.createObjectURL(this.files[0])" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 border-top pt-3 text-end">
                    <button type="submit" class="btn btn-dark rounded-0 px-4">
                        <i class="fas fa-save me-2"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>