@model IEnumerable<WebApp_MoNoFS.Models.Product>

@{
    ViewBag.Title = "Product Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title">Products List</h2>
    <a href="@Url.Action("Create")" class="btn btn-mono">
        <i class="fas fa-plus me-2"></i> Add New Product
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light">
        @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "row g-1 align-items-center" }))
        {
            <div class="col-md-2">
                @if (ViewBag.CatId != null)
                {
                    @Html.DropDownList("catId", (SelectList)ViewBag.CatId, "All", new { @class = "form-select rounded-0" })
                }
                else
                {
                    <select class="form-select rounded-0" disabled>
                        <option>All</option>
                    </select>
                }
            </div>

            <div class="col-md-2">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-0 px-2">
                        <i class="fas fa-hashtag text-muted"></i>
                    </span>
                    <input type="number"
                           name="searchId"
                           value="@ViewBag.CurrentSearchId"
                           class="form-control border-start-0 rounded-0 ps-1"
                           placeholder="ID...">
                </div>
            </div>

            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-0 px-2">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.CurrentFilter"
                           class="form-control border-start-0 rounded-0 ps-1"
                           placeholder="Name...">
                </div>
            </div>

            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white rounded-0 px-2">$</span>

                    <input type="number" name="minPrice" value="@ViewBag.CurrentMinPrice" class="form-control rounded-0 px-1 text-center" placeholder="Min">

                    <span class="input-group-text bg-white border-start-0 border-end-0 px-1">-</span>

                    <input type="number" name="maxPrice" value="@ViewBag.CurrentMaxPrice" class="form-control rounded-0 px-1 text-center" placeholder="Max">

                    <button type="submit" class="btn btn-dark rounded-0">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 product-table">
                <thead class="table-dark text-uppercase">
                    <tr>
                        <th class="ps-4">Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-end">Price ($)</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="product-img-wrapper">
                                        <img src="~/Images/@item.ProImage"
                                             alt="@item.ProName"
                                             class="product-img"
                                             onerror="this.src='https://placehold.co/50x50?text=No+Img'">
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.ProName)</span>
                                    <br />
                                    <small class="text-muted">ID: #@item.ProId</small>
                                </td>
                                <td>
                                    <span class="badge badge-mono-outline">
                                        @Html.DisplayFor(modelItem => item.Category.CatName)
                                    </span>
                                </td>
                                <td class="text-end font-monospace">
                                    @String.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:C0}", item.ProPrice)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.ProId })" class="btn btn-sm btn-icon" title="Edit">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.ProId })" class="btn btn-sm btn-icon" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.ProId })" class="btn btn-sm btn-icon text-danger delete-btn" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p>No products match your search.</p>
                                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-dark rounded-0">Clear Filters</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>